# Internal URL for the Bonsai API (used inside Docker)
BONSAI_API_INTERNAL=http://host.docker.internal

# Service account credentials
AUTOMATION_BONSAI_USERNAME= automation_changeme
AUTOMATION_BONSAI_PASSWORD=automation_changeme
AUTOMATION_MIMOSA_USERNAME=automation_changeme
AUTOMATION_MIMOSA_PASSWORD=automation_changeme

# Profiles and groups (comma-separated; leave empty for all)
AUTOMATION_PROFILES=staphylococcus_aureus,klebsiella_pneumoniae
AUTOMATION_GROUPS=

# Processing mode — at most one should be true
AUTOMATION_UPDATE_ONLY=false
AUTOMATION_RE_CLUSTER=false

# Run similarity analysis after clustering 
AUTOMATION_RUN_SIMILARITY=false

# Scheduler: interval in hours, and whether to run on startup
AUTOMATION_SCHEDULE_HOURS=4
AUTOMATION_RUN_ON_STARTUP=true

